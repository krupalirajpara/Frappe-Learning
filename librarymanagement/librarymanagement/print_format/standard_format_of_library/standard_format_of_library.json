 "html": "<html>\n    <head>\n        <title>Standard Format</title>\n    </head>\n<body>\n<div class=\"container\">\n    <table style=\"width:100%; border:1px solid black;  border-bottom: none;\">\n        <thead>\n            <th colspan=\"12\" class=\"text-center\">\n                <strong>{{doc.name}}</strong>\n            </th>\n        </thead>\n        <tbody>\n            <tr>\n                <td width=\"10%\">Name1:</td>\n                <td width=\"30%\">{{doc.name}}</td>\n                <td width=\"30%\"></td>\n                <td width=\"10%\">Name1:</td>\n                <td width=\"20%\">{{doc.name}}</td>\n            </tr>\n            <tr>\n                <td>Name2:</td>\n                <td>{{doc.name}}</td>\n                <td></td>\n                <td>Name2:</td>\n                <td>{{doc.name}}</td>\n            </tr>\n            <tr>\n                <td>Name3:</td>\n                <td>{{doc.name}}</td>\n                <Td></Td>\n                <td>Name3:</td>\n                <td>{{doc.name}}</td>\n            </tr>\n            <tr>\n                <td>Name4:</td>\n                <td>{{doc.name}}</td>\n                <td></td>\n                <td>Name4:</td>\n                <td>{{doc.name}}</td>\n            </tr>\n        </tbody>\n    </table>\n    <table style=\"width:100%; border:1px solid black;\">\n        <tbody>\n            <tr style=\"border-bottom:1px solid black;\">\n                <td width=\"25%\"> Article</td>\n                <td width=\"35%\"> Description</td>\n                <td width=\"15%\"> Status</td>\n                <td width=\"20%\"> Specially For</td>\n                <td colspan=\"2\" rowspan=\"2\" width=\"5%\"> colspan1\n                <br>colspan2</td>\n            </tr>\n            {%for article in doc.article%}\n            <tr>\n                <td>{{article.article_name}}</td>\n                <td>{{article.description}}</td>\n                <td>{{article.status}}</td>\n                <td>{{article.custom_specially_for}}</td>\n               \n            </tr>\n            {% endfor%}\n            <tr style=\"border-top: 1px solid black;\">\n                <td>Author</td>\n                <td>Name</td>\n                <td>Author</td>\n                <td>Name</td>\n            </tr>\n        </tbody>\n    </table>\n</div>    \n</body>\n</html>\n",
